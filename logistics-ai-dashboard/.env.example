# SupChainMate API Keys — copy to .env and fill in your values
# All keys are optional — features degrade gracefully without them

# Groq (primary AI copilot — LLaMA-3.3-70B, sub-second inference)
# Get your key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# NVIDIA cuOpt (real vehicle route optimisation via NIM)
# Get your key: https://build.nvidia.com
NVIDIA_CUOPT_API_KEY=your_nvidia_cuopt_key_here

# NVIDIA LLaMA (legacy fallback copilot)
NVIDIA_LLAMA_API_KEY=your_nvidia_llama_key_here

# NVIDIA DeepSeek V4 Pro (copilot fallback when Groq is offline)
# Requires NVIDIA NIM access with DeepSeek V4 Pro deployed
NVIDIA_DEEPSEEK_API_KEY=your_deepseek_key_here

# SMTP (optional — enables email alert digests; leave unset to use downloads only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=alerts@yourcompany.com

# Geo stack (all optional — keyless fallbacks apply)
# MapTiler basemap tiles for the Leaflet radar map (free tier: maptiler.com)
MAPTILER_API_KEY=your_maptiler_key_here
# HERE Matrix API for road routing with live traffic (fallback: OSRM public server)
HERE_API_KEY=your_here_key_here
# OpenWeatherMap current conditions (fallback: Open-Meteo, keyless)
OPENWEATHER_API_KEY=your_openweathermap_key_here

# ── NVIDIA NIM — provider-agnostic AI layer (ai/) ─────────────────────────────
# Each capability maps to a model+key in ai/registry.py. All optional:
# missing keys degrade to the Groq/offline fallback path.
NVIDIA_EMBED_API_KEY=your_nemotron_embed_key          # capability: embedding
NVIDIA_REASONING_EXEC_API_KEY=your_nemotron_ultra_key # capability: reasoning.executive
NVIDIA_REASONING_OPS_API_KEY=your_glm_key             # capability: reasoning.operations
NVIDIA_CODING_API_KEY=your_deepseek_flash_key         # capability: coding
# NVIDIA_VISION_API_KEY / NVIDIA_OCR_API_KEY / NVIDIA_SAFETY_API_KEY — when wired
