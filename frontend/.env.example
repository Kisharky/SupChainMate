# SupChainMate frontend — copy to .env.local and adjust as needed.

# Base URL the browser uses to reach the API.
#  - Local dev (npm run dev): leave empty; next.config.mjs proxies /api → :8000.
#  - Docker / split deploy: set to the API's public URL.
NEXT_PUBLIC_API_BASE=

# Dev-only: where next.config.mjs proxies /api/* during `npm run dev`.
API_PROXY_TARGET=http://localhost:8000
