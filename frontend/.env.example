# SupChainMate frontend — copy to .env.local and adjust as needed.

# Base URL the browser uses to reach the API.
#  - Local dev (npm run dev): leave empty; next.config.mjs proxies /api → :8000.
#  - Docker / split deploy: set to the API's public URL.
NEXT_PUBLIC_API_BASE=

# Where next.config.mjs proxies /api/* — used in dev AND on Vercel.
#  - Local dev:  http://localhost:8000
#  - Production (Vercel): https://api.yuktiai.app  → keeps the browser same-origin
#    on app.yuktiai.app (no CORS), so leave NEXT_PUBLIC_API_BASE empty. See DEPLOY.md.
API_PROXY_TARGET=http://localhost:8000
